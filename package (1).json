    await pool.query(
      `UPDATE trips SET date=$1, car_id=$2, customer=$3, revenue=$4, driver_cost=$5, fuel_cost=$6, other_cost=$7
       WHERE id=$8`,
      [date, carId || null, customer || null, revenue || 0, driverCost || 0, fuelCost || 0, otherCost || 0, req.params.id]
    );
    res.json({ ok: true });
