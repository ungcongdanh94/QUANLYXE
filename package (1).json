const jwt = require("jsonwebtoken");
const crypto = require("crypto");

const SECRET =
  process.env.JWT_SECRET ||
  (() => {
    console.warn(
      "[canh bao] Chua dat JWT_SECRET. Dang dung khoa tam thoi - phien dang nhap se mat het khi server restart. " +
        "Hay vao Railway > Variables > them JWT_SECRET (chuoi ngau nhien bat ky, cang dai cang tot)."
    );
    return crypto.randomBytes(32).toString("hex");
  })();

const COOKIE_NAME = "fleet_token";

function signToken(user) {
  return jwt.sign(
    { id: user.id, username: user.username, role: user.role },
    SECRET,
    { expiresIn: "30d" }
  );
}

function setAuthCookie(res, token) {
  res.cookie(COOKIE_NAME, token, {
    httpOnly: true,
    secure: process.env.NODE_ENV === "production",
    sameSite: "lax",
    maxAge: 30 * 24 * 60 * 60 * 1000,
  });
}

function clearAuthCookie(res) {
  res.clearCookie(COOKIE_NAME);
}

function requireAuth(req, res, next) {
  const token = req.cookies?.[COOKIE_NAME];
  if (!token) return res.status(401).json({ error: "Chua dang nhap" });
  try {
    req.user = jwt.verify(token, SECRET);
    next();
  } catch (e) {
    return res.status(401).json({ error: "Phien dang nhap khong hop le, hay dang nhap lai" });
  }
}

function requireAdmin(req, res, next) {
  if (req.user?.role !== "admin") {
    return res.status(403).json({ error: "Chi tai khoan quan tri moi thuc hien duoc thao tac nay" });
  }
  next();
}

module.exports = {
  signToken,
  setAuthCookie,
  clearAuthCookie,
  requireAuth,
  requireAdmin,
  COOKIE_NAME,
};
