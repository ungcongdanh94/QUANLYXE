require("dotenv").config();
const express = require("express");
const path = require("path");
const crypto = require("crypto");
const cookieParser = require("cookie-parser");
const bcrypt = require("bcryptjs");
const { pool, init } = require("./db");
const { signToken, setAuthCookie, clearAuthCookie, requireAuth, requireAdmin } = require("./auth");

const app = express();
app.use(express.json());
app.use(cookieParser());

const uid = () => crypto.randomUUID();

// ---------- AUTH (public routes) ----------
app.post("/api/auth/login", async (req, res) => {
  try {
    const { username, password } = req.body;
    if (!username || !password) return res.status(400).json({ error: "Thieu tai khoan hoac mat khau" });
    const { rows } = await pool.query("SELECT * FROM users WHERE username=$1", [username]);
    const user = rows[0];
    if (!user) return res.status(401).json({ error: "Sai tai khoan hoac mat khau" });
    const ok = await bcrypt.compare(password, user.password_hash);
    if (!ok) return res.status(401).json({ error: "Sai tai khoan hoac mat khau" });
    const token = signToken(user);
    setAuthCookie(res, token);
    res.json({ id: user.id, username: user.username, role: user.role });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

app.post("/api/auth/logout", (req, res) => {
  clearAuthCookie(res);
  res.json({ ok: true });
});

// Moi route /api ben duoi day deu yeu cau da dang nhap
app.use("/api", requireAuth);

app.get("/api/auth/me", (req, res) => {
  res.json({ id: req.user.id, username: req.user.username, role: req.user.role });
});

app.post("/api/auth/change-password", async (req, res) => {
  try {
    const { oldPassword, newPassword } = req.body;
    if (!oldPassword || !newPassword) return res.status(400).json({ error: "Thieu thong tin" });
    if (newPassword.length < 6) return res.status(400).json({ error: "Mat khau moi can it nhat 6 ky tu" });
    const { rows } = await pool.query("SELECT * FROM users WHERE id=$1", [req.user.id]);
    const user = rows[0];
    const ok = await bcrypt.compare(oldPassword, user.password_hash);
    if (!ok) return res.status(400).json({ error: "Mat khau cu khong dung" });
    const hash = await bcrypt.hash(newPassword, 10);
    await pool.query("UPDATE users SET password_hash=$1 WHERE id=$2", [hash, req.user.id]);
    res.json({ ok: true });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

// ---------- USER MANAGEMENT (chi admin) ----------
app.get("/api/users", requireAdmin, async (req, res) => {
  try {
    const { rows } = await pool.query(
      "SELECT id, username, role, created_at FROM users ORDER BY created_at"
    );
    res.json(rows);
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

app.post("/api/users", requireAdmin, async (req, res) => {
  try {
    const { username, password, role } = req.body;
    if (!username || !password) return res.status(400).json({ error: "Thieu tai khoan hoac mat khau" });
    if (password.length < 6) return res.status(400).json({ error: "Mat khau can it nhat 6 ky tu" });
    const hash = await bcrypt.hash(password, 10);
    const id = uid();
    await pool.query(
      "INSERT INTO users (id, username, password_hash, role) VALUES ($1,$2,$3,$4)",
      [id, username, hash, role === "admin" ? "admin" : "staff"]
    );
    res.json({ id, username, role: role === "admin" ? "admin" : "staff" });
  } catch (e) {
    if (e.code === "23505") return res.status(400).json({ error: "Ten tai khoan da ton tai" });
    res.status(500).json({ error: e.message });
  }
});

app.delete("/api/users/:id", requireAdmin, async (req, res) => {
  try {
    if (req.user.id === req.params.id) {
      return res.status(400).json({ error: "Khong the tu xoa tai khoan dang dung" });
    }
    await pool.query("DELETE FROM users WHERE id=$1", [req.params.id]);
    res.json({ ok: true });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

